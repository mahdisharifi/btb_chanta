flowchart LR
    A([شروع]) --> B["صفحه ورود تأمین‌کننده\n(Livewire: LoginForm\nیا AuthController)"]
    B --> C{"اعتبارسنجی موفق؟"}
    C -- خیر --> B
    C -- بله --> D["داشبورد تأمین‌کننده\n(DashboardController\nیا Livewire: Supplier.Dashboard)"]

    D --> E["مدیریت محصولات\n(ProductController\nیا Livewire: MyProducts)"]
    D --> F["مدیریت قیمت‌گذاری\n(PriceController\nیا Livewire: Supplier.Pricing)"]
    D --> G["مدیریت گالری تصاویر\n(GalleryController)"]
    D --> H["گزارش‌ها و آمار\n(AnalyticsController)"]
    D --> I["ویرایش پروفایل\n(ProfileController)"]
    D --> J["خروج\n(Livewire Action: Logout)"]

%% جزئیات مدیریت محصولات
    E --> E1[لیست محصولات]
    E1 --> E2["ایجاد محصول\n(create → store)"]
    E1 --> E3["ویرایش محصول\n(edit → update)"]
    E1 --> E4[حذف محصول]

%% جزئیات مدیریت قیمت‌گذاری
    F --> F1[لیست قیمت‌ها]
F1 --> F2["ویرایش قیمت\n(edit → update)"]

%% جزئیات گالری تصاویر
G --> G1[لیست گالری محصولات]
G1 --> G2["افزودن تصویر\n(create → store)"]
G1 --> G3[حذف تصویر]

%% جزئیات گزارش‌ها و آمار
H --> H1[انتخاب بازه زمانی و فیلترها]
H1 --> H2[نمایش نمودارها و خروجی]

%% جزئیات ویرایش پروفایل
I --> I1[فرم ویرایش پروفایل]
I1 --> I2[ثبت تغییرات]

%% حلقه خروج
J --> B
