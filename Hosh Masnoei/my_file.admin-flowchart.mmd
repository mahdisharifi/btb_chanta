flowchart LR
    A([شروع]) --> B["صفحه ورود مدیر\n(Livewire: LoginForm\nیا AuthController)"]
    B --> C{"اعتبارسنجی موفق؟"}
    C -- خیر --> B
    C -- بله --> D["داشبورد مدیریت\n(DashboardController\nیا Livewire: Admin.Dashboard)"]

    D --> E["مدیریت کاربران\n(UserController\nیا Livewire: Admin.Users.Index)"]
    D --> F["مدیریت دسته‌بندی‌ها\n(CategoryController\nیا Livewire: Admin.Categories.Index)"]
    D --> G["مدیریت محصولات\n(ProductController\nیا Livewire: Admin.Product.Index)"]
    D --> H["مدیریت تأمین‌کنندگان\n(SupplierController\nیا Livewire: Admin.Suppliers.Index)"]
    D --> I["مدیریت صفحات سئو\n(SeoController\nیا Livewire: Admin.Seo.Index)"]
    D --> J["مدیریت قیمت‌های خرده‌فروشی\n(RetailPriceController\nیا Livewire: Admin.RetailPrices.Index)"]
    D --> K["تنظیمات سیستم\n(AppServiceProvider یا فایل‌های Config)"]
    D --> L["خروج\n(Livewire Action: Logout)"]

    %% جزئیات مدیریت کاربران
    E --> E1[لیست کاربران]
    E1 --> E2["ایجاد کاربر\n(create → store)"]
    E1 --> E3["ویرایش کاربر\n(edit → update)"]
    E1 --> E4[حذف کاربر]

    %% جزئیات دسته‌بندی‌ها
    F --> F1[لیست دسته‌بندی‌ها]
    F1 --> F2["ایجاد دسته‌بندی\n(create → store)"]
    F1 --> F3["ویرایش دسته‌بندی\n(edit → update)"]
    F1 --> F4[حذف دسته‌بندی]

    %% جزئیات محصولات
    G --> G1[لیست محصولات]
    G1 --> G2["ایجاد محصول\n(create → store)"]
    G1 --> G3["ویرایش محصول\n(edit → update)"]
    G1 --> G4[حذف محصول]

    %% جزئیات تأمین‌کنندگان
    H --> H1[لیست تأمین‌کنندگان]
    H1 --> H2["ایجاد تأمین‌کننده\n(create → store)"]
    H1 --> H3["ویرایش تأمین‌کننده\n(edit → update)"]
    H1 --> H4[حذف تأمین‌کننده]

    %% جزئیات صفحات سئو
    I --> I1[لیست صفحات سئو]
    I1 --> I2["ایجاد صفحه سئو\n(create → store)"]
    I1 --> I3["ویرایش صفحه سئو\n(edit → update)"]
    I1 --> I4[حذف صفحه سئو]

    %% جزئیات قیمت‌های خرده‌فروشی
    J --> J1[لیست قیمت‌ها]
    J1 --> J2["ایجاد قیمت\n(create → store)"]
    J1 --> J3["ویرایش قیمت\n(edit → update)"]
    J1 --> J4[حذف قیمت]

    %% حلقه خروج
    L --> B
